# =============================================================================
# Docker Compose interpolation variables (LOCAL profile)
# =============================================================================
# Copy to .env.compose.local and fill in values:
#   cp .env.compose.local.example .env.compose.local
#
# Use with:
#   docker compose --env-file .env.compose.local up -d
#
# This file drives ${VAR} interpolation in docker-compose.yml.
# FastAPI app variables are loaded from BACKEND_ENV_FILE below.
# =============================================================================

# Backend dotenv for local mode
BACKEND_ENV_FILE=./apps/backend/.env.local

# Images / runtime profile
TAG=latest
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=auto

# Gitea Docker services (gitea_db + gitea)
GITEA_DB_PASSWORD=your-gitea-db-password
GITEA_SECRET_KEY=your-gitea-secret-key
GITEA_INTERNAL_TOKEN=your-gitea-internal-token

# Token broker / ops
# BROKER_API_KEY protects the /mint-token endpoint on the token-broker.
# If set, FastAPI must send the same value as X-Internal-API-Key.
# Leave empty for local dev (broker is only reachable inside Docker network).
# Generate: openssl rand -hex 32
GITEA_CONTAINER_NAME=gitea
DOCKER_EXEC_TIMEOUT_SECONDS=15
BROKER_API_KEY=

# Redis password (used by --requirepass and REDIS_URL in docker-compose)
# Generate with hex to avoid URL-unsafe chars: openssl rand -hex 32
REDIS_PASSWORD=your-redis-password

# Host home directory (SSH key mount for fastapi container)
# macOS: /Users/YourUsername   Windows: C:\Users\YourUsername
HOME=C:\Users\YourUsername
