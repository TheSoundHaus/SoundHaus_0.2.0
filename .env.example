# =============================================================================
# Docker Compose variable substitution
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These vars are used by docker-compose.yml for ${VAR} interpolation.
# Backend app config lives in apps/backend/.env (loaded via env_file).
# =============================================================================

# Gitea Docker services (gitea_db + gitea)
# Generate secure values:
#   openssl rand -hex 32                              (for GITEA_DB_PASSWORD)
#   docker run --rm gitea/gitea:1.24.6 gitea generate secret SECRET_KEY   (for GITEA_SECRET_KEY)
#   docker run --rm gitea/gitea:1.24.6 gitea generate secret INTERNAL_TOKEN (for GITEA_INTERNAL_TOKEN)
GITEA_DB_PASSWORD=your-gitea-db-password
GITEA_SECRET_KEY=your-gitea-secret-key
GITEA_INTERNAL_TOKEN=your-gitea-internal-token

# Host home directory (used for SSH key volume mount)
HOME=C:\Users\YourUsername
# This file documents variables interpolated by docker-compose.yml.
# Copy to .env in the project root if you need to override defaults.
# Service-specific secrets live in apps/backend/.env (see .env.example there).
# NEVER commit .env files with real credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared Docker Compose Variables
# -----------------------------------------------------------------------------
# These are interpolated by docker-compose.yml via ${VAR:-default} syntax.
# Most have sensible defaults — only override when needed.

# Build tag for Docker images (default: latest)
# TAG=latest

# Environment mode — applies to fastapi, worker, and token-broker
# ENVIRONMENT=development

# Log level for all services
# LOG_LEVEL=INFO
# LOG_FORMAT=auto

# Thread count for Demucs stem worker (match your CPU core count)
# OMP_NUM_THREADS=4
# MKL_NUM_THREADS=4

# Token Broker settings
# BROKER_API_KEY=
# GITEA_CONTAINER_NAME=gitea
# DOCKER_EXEC_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Gitea Admin Token
# -----------------------------------------------------------------------------
# Generate after first Gitea setup:
# 1. Access Gitea at http://localhost:3000
# 2. Login with admin account
# 3. Go to: Settings → Applications → Manage Access Tokens
# 4. Generate new token with ALL scopes (especially write:admin)
# 5. Copy to apps/backend/.env as GITEA_ADMIN_TOKEN

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_URL=http://localhost:8000
