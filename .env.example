# =============================================================================
# Docker Compose variable substitution
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These vars are used by docker-compose.yml for ${VAR} interpolation.
# Backend app config lives in apps/backend/.env (loaded via env_file).
# =============================================================================

# Gitea Docker services (gitea_db + gitea)
# Generate secure values:
#   openssl rand -hex 32                              (for GITEA_DB_PASSWORD)
#   docker run --rm gitea/gitea:1.24.6 gitea generate secret SECRET_KEY   (for GITEA_SECRET_KEY)
#   docker run --rm gitea/gitea:1.24.6 gitea generate secret INTERNAL_TOKEN (for GITEA_INTERNAL_TOKEN)
GITEA_DB_PASSWORD=your-gitea-db-password
GITEA_SECRET_KEY=your-gitea-secret-key
GITEA_INTERNAL_TOKEN=your-gitea-internal-token

# Host home directory (used for SSH key volume mount)
HOME=C:\Users\YourUsername
