# API Configuration (server-side, used in Server Actions and API routes)
API_URL=http://localhost:8000

# API Configuration (client-side, used in browser bundles — must have NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Gitea public URL (client-side, used in clone links)
NEXT_PUBLIC_GITEA_URL=https://git.thesound.haus

# Feature Flags
VITE_ENABLE_DEBUG=false
