{
  "name": "semantic-differ",
  "version": "0.2.0",
  "description": "Ableton Live Set semantic diff parser (NAPI-RS)",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "parser",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "postinstall": "napi build --platform --release"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.2.0"
  },
  "license": "MIT"
}
