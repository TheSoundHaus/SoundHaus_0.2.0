# ──────────────────────────────────────────────
# SoundHaus Backend — Production Environment
# ──────────────────────────────────────────────
# Place at /opt/soundhaus/apps/backend/.env.production
# ──────────────────────────────────────────────

# Gitea Configuration (production instance)
GITEA_URL=http://gitea:3000
GITEA_PUBLIC_URL=https://git.thesound.haus
GITEA_ADMIN_TOKEN=<production-gitea-admin-token>
GITEA_CONTAINER_NAME=gitea

# Supabase Configuration
SUPABASE_URL=<production-supabase-url>
SUPABASE_PUB_KEY=<production-supabase-pub-key>
SUPABASE_SERVICE_KEY=<production-supabase-service-key>

# Database (Supabase PostgreSQL)
DATABASE_URL=<production-database-url>

# Webhook Configuration
GITEA_WEBHOOK_SECRET=<production-webhook-secret>
WEBHOOK_BASE_URL=http://fastapi:8000
TOKEN_BROKER_URL=http://token-broker:9000
TOKEN_BROKER_API_KEY=<production-broker-api-key>

# Rate Limiting (strict for production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_UPLOAD=20/minute

# Password reset
PASSWORD_RESET_EMAIL_ENABLED=true

# Testing (leave empty in production)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Redis
REDIS_URL=redis://:your-production-redis-password@redis:6379/0
