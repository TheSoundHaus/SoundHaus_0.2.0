FROM python:3.11-slim

LABEL org.opencontainers.image.title="SoundHaus Stem Worker"
LABEL org.opencontainers.image.description="Demucs stem-separation worker"

WORKDIR /app

# System deps (ffmpeg is required by Demucs for audio decoding)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ffmpeg \
        git \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Python deps — install backend requirements first for cache efficiency
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements.txt

# Install Demucs (and its torch dependency)
# lameenc: enables --mp3 output flag (avoids torchaudio/torchcodec issues)
# soundfile: lightweight audio I/O fallback backend for torchaudio
RUN pip install --no-cache-dir demucs lameenc soundfile

# Copy backend code (also mounted as volume in dev, but needed for build)
COPY . /app

# Non-root user
RUN useradd -m -u 1000 -s /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
