# =============================================================================
# SoundHaus Backend environment (REMOTE profile)
# =============================================================================
# Copy to .env.remote and fill in values:
#   cp .env.remote.example .env.remote
#
# Loaded by docker-compose fastapi env_file via BACKEND_ENV_FILE.
# =============================================================================

# Gitea Configuration
GITEA_URL=http://gitea:3000
GITEA_PUBLIC_URL=http://YOUR_DROPLET_IP:3000
GITEA_ADMIN_TOKEN=your-gitea-admin-token
GITEA_CONTAINER_NAME=gitea

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUB_KEY=your-supabase-public-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/dbname

# API / Webhook / Token Broker
# TOKEN_BROKER_API_KEY must match BROKER_API_KEY in .env.compose.remote
API_BASE_URL=https://api.your-domain.tld
GITEA_WEBHOOK_SECRET=generate-a-random-secret
WEBHOOK_BASE_URL=https://api.your-domain.tld
TOKEN_BROKER_URL=http://token-broker:9000
TOKEN_BROKER_API_KEY=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_UPLOAD=5/minute

# Password reset (Supabase email)
PASSWORD_RESET_EMAIL_ENABLED=true

# Testing
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Redis
REDIS_URL=redis://redis:6379/0
