# ──────────────────────────────────────────────
# SoundHaus Backend — Staging Environment
# ──────────────────────────────────────────────
# Place at /opt/soundhaus-staging/apps/backend/.env.staging
# ──────────────────────────────────────────────

# Gitea Configuration (staging instance)
GITEA_URL=http://gitea:3000
GITEA_PUBLIC_URL=https://staging-git.thesound.haus
GITEA_ADMIN_TOKEN=<staging-gitea-admin-token>
GITEA_CONTAINER_NAME=gitea

# Supabase Configuration (can share with production or use separate project)
SUPABASE_URL=<staging-supabase-url>
SUPABASE_PUB_KEY=<staging-supabase-pub-key>
SUPABASE_SERVICE_KEY=<staging-supabase-service-key>

# Database (Supabase PostgreSQL)
DATABASE_URL=<staging-database-url>

# Webhook Configuration
GITEA_WEBHOOK_SECRET=<staging-webhook-secret>
WEBHOOK_BASE_URL=http://fastapi:8000
TOKEN_BROKER_URL=http://token-broker:9000
TOKEN_BROKER_API_KEY=<staging-broker-api-key>

# Rate Limiting (relaxed for staging/testing)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=200/minute

# Password reset
PASSWORD_RESET_EMAIL_ENABLED=false

# Testing credentials (for CI integration tests)
TEST_USER_EMAIL=<staging-test-user-email>
TEST_USER_PASSWORD=<staging-test-user-password>

# Redis
REDIS_URL=redis://:your-staging-redis-password@redis:6379/0
