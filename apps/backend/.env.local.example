# =============================================================================
# SoundHaus Backend environment (LOCAL profile)
# =============================================================================
# Copy to .env.local and fill in values:
#   cp .env.local.example .env.local
#
# Loaded by docker-compose fastapi env_file via BACKEND_ENV_FILE.
# =============================================================================

# API target used by tests running from host machine
API_BASE_URL=http://localhost:8000

# Gitea Configuration
GITEA_URL=http://gitea:3000
GITEA_PUBLIC_URL=http://localhost:3000
GITEA_ADMIN_TOKEN=your-gitea-admin-token
GITEA_CONTAINER_NAME=gitea

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUB_KEY=your-supabase-public-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Webhook / Token Broker
# TOKEN_BROKER_API_KEY must match BROKER_API_KEY in .env.compose.local
# Leave both empty for local dev.
GITEA_WEBHOOK_SECRET=generate-a-random-secret
WEBHOOK_BASE_URL=http://fastapi:8000
TOKEN_BROKER_URL=http://token-broker:9000
TOKEN_BROKER_API_KEY=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_UPLOAD=5/minute

# Password reset (Supabase email)
PASSWORD_RESET_EMAIL_ENABLED=true

# Testing
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Redis
REDIS_URL=redis://redis:6379/0
