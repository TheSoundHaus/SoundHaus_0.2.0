# =============================================================================
# Docker Compose interpolation variables (REMOTE profile)
# =============================================================================
# Copy to .env.compose.remote and fill in values:
#   cp .env.compose.remote.example .env.compose.remote
#
# Use with:
#   docker compose --env-file .env.compose.remote up -d
#
# This file drives ${VAR} interpolation in docker-compose.yml.
# FastAPI app variables are loaded from BACKEND_ENV_FILE below.
# =============================================================================

# Backend dotenv for remote mode
BACKEND_ENV_FILE=./apps/backend/.env.remote

# Images / runtime profile
TAG=latest
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=auto

# Gitea Docker services (gitea_db + gitea)
GITEA_DB_PASSWORD=your-gitea-db-password
GITEA_SECRET_KEY=your-gitea-secret-key
GITEA_INTERNAL_TOKEN=your-gitea-internal-token

# Token broker / ops
# BROKER_API_KEY protects the /mint-token endpoint.
# Set a strong random value in production — must match TOKEN_BROKER_API_KEY
# in apps/backend/.env.remote (FastAPI reads it to authenticate requests).
# Generate: openssl rand -hex 32
GITEA_CONTAINER_NAME=gitea
DOCKER_EXEC_TIMEOUT_SECONDS=15
BROKER_API_KEY=

# Host home directory (SSH key mount for fastapi container)
# On a DigitalOcean droplet running as root this is /root
HOME=/root
