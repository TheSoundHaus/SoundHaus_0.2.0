# =============================================================================
# Docker Compose — Production Environment (.env.compose.production)
# =============================================================================
# Used on the production server at /opt/soundhaus/
# Copy this file: cp .env.compose.production.example .env.compose.production
# =============================================================================

# Gitea Docker services
GITEA_DB_PASSWORD=<production-gitea-db-password>
GITEA_SECRET_KEY=<production-gitea-secret-key>
GITEA_INTERNAL_TOKEN=<production-gitea-internal-token>

# Backend env file path (production uses its own env)
BACKEND_ENV_FILE=./apps/backend/.env.production

# Runtime
TAG=latest
ENVIRONMENT=production
LOG_LEVEL=WARNING
LOG_FORMAT=json

# Token Broker
GITEA_CONTAINER_NAME=gitea
DOCKER_EXEC_TIMEOUT_SECONDS=15
BROKER_API_KEY=<production-broker-api-key>

# Redis
REDIS_PASSWORD=<production-redis-password>

# Host home directory (server)
HOME=/root

# API (production runs on port 8000)
API_URL=http://localhost:8000
