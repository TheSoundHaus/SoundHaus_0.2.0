# =============================================================================
# Docker Compose — Staging Environment (.env.compose.staging)
# =============================================================================
# Used on the staging server at /opt/soundhaus-staging/
# Copy this file: cp .env.compose.staging.example .env.compose.staging
# =============================================================================

# Gitea Docker services
GITEA_DB_PASSWORD=<staging-gitea-db-password>
GITEA_SECRET_KEY=<staging-gitea-secret-key>
GITEA_INTERNAL_TOKEN=<staging-gitea-internal-token>

# Backend env file path (staging uses its own env)
BACKEND_ENV_FILE=./apps/backend/.env.staging

# Runtime
TAG=latest
ENVIRONMENT=staging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Token Broker
GITEA_CONTAINER_NAME=gitea
DOCKER_EXEC_TIMEOUT_SECONDS=15
BROKER_API_KEY=<staging-broker-api-key>

# Redis
REDIS_PASSWORD=<staging-redis-password>

# Host home directory (server)
HOME=/root

# API (staging runs on port 8001 to coexist with production)
API_URL=http://localhost:8001
